# Copy this file to .env and fill in your values: cp .env.example .env
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Pin a version when you rely on thresholds; use ~typesafe/jev-latest to track the newest release
JEV_MODEL=typesafe/jev-1.14

OPENROUTER_BASE_URL=https://openrouter.ai/api/alpha

# Where `uv run jev` serves the API
HOST=127.0.0.1
PORT=8000
